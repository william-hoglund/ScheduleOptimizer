#
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored and must never be committed.
#
# ── Which of these reach the browser ────────────────────────────────────────
# Next.js inlines ONLY variables prefixed with NEXT_PUBLIC_ into the JavaScript
# that is sent to the browser. Everything else stays on the server.
# So: nothing secret ever gets a NEXT_PUBLIC_ prefix.
# ────────────────────────────────────────────────────────────────────────────


# ── Public (safe in the browser) ────────────────────────────────────────────

# Where the app is served from. Used for OAuth redirects and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Your Supabase project URL. Public by design.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" key. This is MEANT to be public — it grants no access on its own.
# Row Level Security decides what each signed-in student may read or write,
# which is why RLS has to be correct on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── Secret (server only — never expose) ─────────────────────────────────────

# Bypasses ALL Row Level Security. Full read/write to every user's data.
# Only ever used in server code that has already checked who is asking.
SUPABASE_SERVICE_ROLE_KEY=

# Which AI provider to use: "openai" or "anthropic". Both keys are optional —
# the product works fully with AI disabled — but whichever provider is named
# here needs its key set, or every AI feature quietly hides itself.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pinned to a dated snapshot rather than a moving "latest" alias, so upgrading
# the model is a deliberate choice here, not a silent behaviour change.
OPENAI_MODEL=gpt-4o-2024-08-06
ANTHROPIC_MODEL=claude-sonnet-5

# Google Calendar OAuth.
# The redirect URI must match exactly what is registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Encrypts Google refresh tokens before they are stored (AES-256-GCM).
# Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=

# Shared secret proving a request really came from the scheduled job runner
# and not from the open internet.
# Generate with:  openssl rand -base64 32
CRON_SECRET=
